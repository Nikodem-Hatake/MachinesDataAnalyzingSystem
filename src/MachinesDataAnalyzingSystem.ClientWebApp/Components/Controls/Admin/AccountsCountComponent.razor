<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h4">Accounts</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Spacing="5">
            <MudItem xs="12" lg="6">
                <MudPaper Elevation="3">
                    <MudText Align="Align.Center" Typo="Typo.h5">Total users: @_accountsCountResponse.TotalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="6">
                <MudPaper Elevation="3">
                    <MudText Align="Align.Center" Typo="Typo.h5">Admins: @_accountsCountResponse.AdminAccountsCount</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudCardContent>
    <MudCardActions>
        <MudGrid Spacing="5">
            <MudItem>
                <MudTextField @bind-Value="_email" Label="email" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem class="align-content-center">
                <MudButton OnClick="async () => await AddAdminRoleToAccount()" Color="Color.Primary" Variant="Variant.Filled">Add admin role</MudButton>
            </MudItem>
            <MudItem class="align-content-center">
                <MudButton OnClick="async () => await RemoveAdminRoleFromAccount()" Color="Color.Error" Variant="Variant.Filled">Remove admin role</MudButton>
            </MudItem>
        </MudGrid>
    </MudCardActions>
</MudCard>