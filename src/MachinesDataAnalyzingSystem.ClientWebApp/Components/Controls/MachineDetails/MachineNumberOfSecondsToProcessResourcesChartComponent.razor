<MudCard style="height: 100%">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Seconds to process resources</MudText>
    </MudCardHeader>
    <MudCardContent class="align-center justify-center d-flex flex-column">
        <MudChart
            ChartLabels="_xAxisLabels"
            ChartSeries="([_chartSeries.ToArray()])"
            ChartType="ChartType.Donut"
            T="float"
        />
    </MudCardContent>
</MudCard>