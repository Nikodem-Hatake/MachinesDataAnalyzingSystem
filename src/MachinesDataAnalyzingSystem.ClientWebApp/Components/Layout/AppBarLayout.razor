<MudAppBar>
    <MudLink Color="Color.Inherit" Href="/" Typo="Typo.h4">Machines Data Analyzing System</MudLink>
    <MudIcon 
        Icon="@Icons.Material.Filled.BarChart" 
        Size="Size.Large"
    />
    <MudSpacer/>
    <MudSwitch
        Size="Size.Large"
        ValueChanged="OnThemeModeChanged"
        ThumbIcon="@(IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" 
        ThumbIconColor="Color.Dark"
    />
    <AuthorizeView>
        <Authorized>
            <MudIconButton 
                Icon="@Icons.Material.Filled.Menu" 
                OnClick="ToggleMenu"
            />
        </Authorized>
        <NotAuthorized>
            <MudLink Color="Color.Inherit" Href="/Login">Login</MudLink>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

<AuthorizeView>
    <Authorized>
        <MudDrawer @bind-Open="_isMenuOpened">
            <MudButton Disabled="true" EndIcon="@Icons.Material.Filled.AccountCircle" Variant="Variant.Text">@context.User.FindFirst(x => x.Type == ClaimTypes.Email)?.Value </MudButton>
            <MudNavMenu>
                <MudNavLink Href="/logout">logout</MudNavLink>
                @if(context.User.IsInRole("admin"))
                {
                    <MudNavLink Href="/admin">admin panel</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>
    </Authorized>
</AuthorizeView>