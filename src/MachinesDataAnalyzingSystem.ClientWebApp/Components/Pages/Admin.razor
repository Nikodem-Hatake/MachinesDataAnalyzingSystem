@page "/admin"

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        @if(context.User.IsInRole("admin"))
        {
            <MudGrid class="mt-5" Spacing="5">
                <MudItem xs="5">
                    <AccountsCountComponent />
                    <MachineDatasCountComponent />
                </MudItem>
                <MudItem xs="7">
                    <MachinesManagementComponent />
                </MudItem>
            </MudGrid>
        }
        else
        {
            <RedirectToComponent Url="/Login" />
        }
    </Authorized>
    <Authorizing></Authorizing>
    <NotAuthorized>
        @if(_isFirstRender)
        {
            <RedirectToComponent Url="/Login"/>
        }
    </NotAuthorized>
</AuthorizeView>